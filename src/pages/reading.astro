---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Entries keep the order they have in src/data/reading.yaml (newest first).
const entries = await getCollection('reading');
---

<Layout>
	<header class="header">
		<a href="/" class="back-link">← Back to Home</a>
		<h1>Reading</h1>
		{/* TODO(Ian): a one-line intro in your own words, if you want one. */}
	</header>

	<ol class="reading-list">
		{entries.map(({ data }) => (
			<li class="entry">
				<span class="check" aria-hidden="true">{data.finished ? '✓' : ''}</span>
				<div class="body">
					<a class="title" href={data.url} target="_blank" rel="noopener noreferrer">
						{data.title}<span class="arrow" aria-hidden="true"> ↗</span>
					</a>
					{data.finished && <span class="sr-only">(finished)</span>}
					{data.author && <p class="author">{data.author}</p>}
					{data.note && <p class="note">{data.note}</p>}
				</div>
			</li>
		))}
	</ol>
</Layout>

<style>
	.header,
	.reading-list {
		max-width: 800px;
		margin: 0 auto;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	}

	.header {
		padding: 1.5rem 2rem 0;
	}

	.back-link {
		display: inline-block;
		color: #3245ff;
		text-decoration: none;
		margin-bottom: 1rem;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: #bc52ee;
		text-decoration: underline;
	}

	h1 {
		margin: 0;
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #111827;
	}

	.reading-list {
		list-style: none;
		padding: 1.25rem 2rem 3rem;
	}

	.entry {
		display: flex;
		gap: 0.5rem;
		padding: 1.1rem 0;
		border-top: 1px solid #e5e7eb;
	}

	.entry:last-child {
		border-bottom: 1px solid #e5e7eb;
	}

	.check {
		flex: 0 0 1.25rem;
		color: #3245ff;
		font-weight: 700;
		line-height: 1.5;
	}

	.body {
		min-width: 0;
	}

	.title {
		font-size: 1.15rem;
		font-weight: 650;
		line-height: 1.4;
		color: #111827;
		text-decoration: none;
		transition: color 0.15s;
	}

	.title:hover {
		color: #3245ff;
	}

	.arrow {
		color: #3245ff;
		font-size: 0.85em;
	}

	.author {
		margin: 0.3rem 0 0;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6b7280;
	}

	.note {
		margin: 0.45rem 0 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #4b5563;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
