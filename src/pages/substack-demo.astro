---
import Layout from "../layouts/Layout.astro";
import OfficialEmbeds from "../components/substack/OfficialEmbeds.astro";
import PostCards from "../components/substack/PostCards.astro";
import PostList from "../components/substack/PostList.astro";
import FeaturedPlusList from "../components/substack/FeaturedPlusList.astro";
import SubscribeCta from "../components/substack/SubscribeCta.astro";
import { getPosts, SUBSTACK_URL } from "../lib/substack";

const posts = await getPosts(4);
const live = posts.some((post) => post.date !== null);

const options: {
  id: string;
  name: string;
  summary: string;
  pros: string[];
  cons: string[];
  note?: string;
}[] = [
  {
    id: "a",
    name: "Official Substack embeds",
    summary:
      "The snippets straight from Substack. Each becomes an iframe card rendered by Substack's own script.",
    pros: ["Zero maintenance per post", "Always matches Substack's styling"],
    cons: [
      "Third-party script + iframes on every page load",
      "Styling is Substack's, not yours",
      "You paste a new snippet for each post by hand",
    ],
    note: "Substack's embed script is blocked in this sandbox, so you're seeing the plain-text fallback below. Run it locally and each block becomes a bordered Substack card with your avatar and publication name.",
  },
  {
    id: "b",
    name: "Card grid",
    summary: "Cover image, date, title, and blurb per post, styled like the rest of your site.",
    pros: ["Most visual weight", "Uses your fonts and colors", "No third-party JS"],
    cons: ["Cover images make the section tall", "Needs images to look good"],
  },
  {
    id: "c",
    name: "Compact list",
    summary: "Title, date, and a two-line blurb. Reads like the rest of your links.",
    pros: ["Lightest touch", "Scales fine to 10+ posts", "Fits your existing page rhythm"],
    cons: ["Easy to scroll past", "No visual pull"],
  },
  {
    id: "d",
    name: "Featured post + list",
    summary: "The newest post gets a big card; older ones fall into a tight list underneath.",
    pros: ["Highlights your best/latest work", "Stays compact as the archive grows"],
    cons: ["Slightly more markup to maintain"],
  },
];
---

<Layout>
  <div class="demo">
    <header>
      <a class="back" href="/">← Back to Home</a>
      <h1>Substack embed options</h1>
      <p class="intro">
        Four ways to put your writing on the landing page. Pick one (or mix — e.g. a list plus the
        subscribe box) and I'll wire it in and delete the rest.
      </p>
      <p class={`status ${live ? "live" : "stale"}`}>
        {
          live
            ? `Pulling ${posts.length} posts live from ${SUBSTACK_URL}/feed at build time.`
            : "Feed unreachable from this sandbox, so B/C/D are rendering the hardcoded fallback list (no dates or cover images). On your machine they'll show real posts, dates, and images."
        }
      </p>
    </header>

    {
      options.map((option) => (
        <section>
          <div class="label">
            <span class="chip">Option {option.id.toUpperCase()}</span>
            <h2>{option.name}</h2>
          </div>
          <p class="summary">{option.summary}</p>
          {option.note && <p class="status stale">{option.note}</p>}
          <ul class="tradeoffs">
            {option.pros.map((pro) => (
              <li class="pro">{pro}</li>
            ))}
            {option.cons.map((con) => (
              <li class="con">{con}</li>
            ))}
          </ul>
          <div class="preview">
            {option.id === "a" && <OfficialEmbeds />}
            {option.id === "b" && <PostCards posts={posts} />}
            {option.id === "c" && <PostList posts={posts} />}
            {option.id === "d" && <FeaturedPlusList posts={posts} />}
          </div>
        </section>
      ))
    }

    <section>
      <div class="label">
        <span class="chip">Add-on</span>
        <h2>Subscribe box</h2>
      </div>
      <p class="summary">
        Drops under whichever option you pick. Links to your Substack subscribe page rather than
        embedding Substack's iframe form, so it stays on-brand and adds no third-party JS.
      </p>
      <div class="preview">
        <SubscribeCta />
      </div>
    </section>
  </div>
</Layout>

<style>
  .demo {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial, sans-serif;
    color: #4b5563;
    line-height: 1.7;
  }

  .back {
    display: inline-block;
    color: #3245ff;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back:hover {
    color: #bc52ee;
    text-decoration: underline;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .intro {
    margin: 0 0 1rem;
  }

  .status {
    margin: 0;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .status.live {
    background: #ecfdf5;
    color: #065f46;
  }

  .status.stale {
    background: #fffbeb;
    color: #92400e;
  }

  section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.4rem;
  }

  .chip {
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    background: #111827;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #111827;
  }

  .summary {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .summary + .status {
    margin-bottom: 0.9rem;
  }

  .tradeoffs {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tradeoffs li {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .pro {
    background: #f0fdf4;
    color: #15803d;
  }

  .con {
    background: #fef2f2;
    color: #b91c1c;
  }

  .preview {
    padding: 1.5rem;
    background: #f9fafb;
    border: 1px dashed #d1d5db;
    border-radius: 12px;
  }
</style>
