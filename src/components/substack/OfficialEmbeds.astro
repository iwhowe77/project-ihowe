---
import { SUBSTACK_URL } from "../../lib/substack";

const posts = [
  {
    title: "Community Without the Commute by Ian Howe",
    blurb:
      "I brought a sense of neighborliness into my NYC apartment, and it was a lot easier than I thought it'd be.",
    url: `${SUBSTACK_URL}/p/community-without-the-commute`,
  },
  {
    title: "What Makes You Feel Fully Alive? by Ian Howe",
    blurb: "Reflections from a Weekend filled with meaningful connection",
    url: `${SUBSTACK_URL}/p/what-makes-you-feel-fully-alive`,
  },
  {
    title: "Howe to talk to people IRL by Ian Howe",
    blurb: "",
    url: `${SUBSTACK_URL}/p/howe-to-talk-to-people-irl`,
  },
];
---

<div class="official-embeds">
  {
    posts.map((post) => (
      <div class="substack-post-embed">
        <p lang="en">{post.title}</p>
        <p>{post.blurb}</p>
        <a data-post-link href={post.url}>
          Read on Substack
        </a>
      </div>
    ))
  }
</div>

<script async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>

<style>
  .official-embeds {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
