---
import { formatDate, type Post } from "../../lib/substack";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="cards">
  {
    posts.map((post) => (
      <a class="card" href={post.url} target="_blank" rel="noopener noreferrer">
        {post.image && <img class="cover" src={post.image} alt="" loading="lazy" />}
        <div class="body">
          {post.date && <span class="date">{formatDate(post.date)}</span>}
          <h3>{post.title}</h3>
          {post.subtitle && <p>{post.subtitle}</p>}
          <span class="read">Read on Substack →</span>
        </div>
      </a>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  .card:hover {
    border-color: #3245ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(17, 24, 39, 0.07);
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.2rem 1.2rem;
    flex: 1;
  }

  .date {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9ca3af;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    color: #111827;
  }

  p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6b7280;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #3245ff;
  }

  .card:hover .read {
    color: #bc52ee;
  }
</style>
