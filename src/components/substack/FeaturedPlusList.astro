---
import { formatDate, type Post } from "../../lib/substack";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const [featured, ...rest] = posts;
---

<div class="featured-block">
  <a class="featured" href={featured.url} target="_blank" rel="noopener noreferrer">
    {featured.image && <img class="cover" src={featured.image} alt="" loading="lazy" />}
    <div class="body">
      <span class="eyebrow">Latest{featured.date && ` · ${formatDate(featured.date)}`}</span>
      <h3>{featured.title}</h3>
      {featured.subtitle && <p>{featured.subtitle}</p>}
      <span class="read">Read on Substack →</span>
    </div>
  </a>

  {
    rest.length > 0 && (
      <ul class="rest">
        {rest.map((post) => (
          <li>
            <a href={post.url} target="_blank" rel="noopener noreferrer">
              <span class="title">{post.title}</span>
              {post.date && <span class="date">{formatDate(post.date)}</span>}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .featured-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .featured {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .featured:hover {
    border-color: #3245ff;
    box-shadow: 0 8px 20px rgba(17, 24, 39, 0.07);
  }

  .cover {
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    display: block;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9ca3af;
  }

  h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: #111827;
  }

  .body p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #6b7280;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #3245ff;
  }

  .featured:hover .read {
    color: #bc52ee;
  }

  .rest {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rest li {
    border-bottom: 1px solid #f3f4f6;
  }

  .rest li:last-child {
    border-bottom: none;
  }

  .rest a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    text-decoration: none;
  }

  .title {
    font-size: 0.975rem;
    font-weight: 600;
    color: #374151;
    transition: color 0.15s;
  }

  .rest a:hover .title {
    color: #3245ff;
  }

  .date {
    flex-shrink: 0;
    font-size: 0.8rem;
    color: #9ca3af;
    font-variant-numeric: tabular-nums;
  }
</style>
