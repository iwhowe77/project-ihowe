---
import { formatDate, type Post } from "../../lib/substack";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={post.url} target="_blank" rel="noopener noreferrer">
          <span class="title">{post.title}</span>
          {post.date && <span class="date">{formatDate(post.date)}</span>}
        </a>
        {post.subtitle && <p>{post.subtitle}</p>}
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.85rem 0;
    border-bottom: 1px solid #f3f4f6;
  }

  li:first-child {
    padding-top: 0;
  }

  li:last-child {
    border-bottom: none;
  }

  a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    transition: color 0.15s;
  }

  a:hover .title {
    color: #3245ff;
  }

  .date {
    flex-shrink: 0;
    font-size: 0.8rem;
    color: #9ca3af;
    font-variant-numeric: tabular-nums;
  }

  p {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6b7280;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
