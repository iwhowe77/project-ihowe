---
import { SUBSTACK_URL } from "../../lib/substack";
---

<a class="subscribe" href={`${SUBSTACK_URL}/subscribe`} target="_blank" rel="noopener noreferrer">
  <div>
    <strong>Subscribe to the newsletter</strong>
    <span>Occasional notes on community, curiosity, and Brooklyn shenanigans.</span>
  </div>
  <span class="button">Subscribe</span>
</a>

<style>
  .subscribe {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .subscribe:hover {
    border-color: #3245ff;
    box-shadow: 0 8px 20px rgba(17, 24, 39, 0.07);
  }

  div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  strong {
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
  }

  span {
    font-size: 0.875rem;
    color: #6b7280;
  }

  .button {
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    background: #3245ff;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .subscribe:hover .button {
    background: #bc52ee;
  }
</style>
